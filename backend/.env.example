# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Server
PORT=3001
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# Embeddings: local by default (free)
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# AI providers (at least one required for chat)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Ingest
GITHUB_USERNAME=
# GITHUB_TOKEN=
INGEST_SECRET=change-me
# CV_PATH=./data/CV.pdf

# RAG / agent
# RAG_HYBRID=true
# RAG_MATCH_THRESHOLD=0.35
# RAG_MATCH_COUNT=5
# AGENT_MODE=true
# CHAT_RATE_LIMIT=30
